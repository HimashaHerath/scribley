# Scribley Environment Configuration
# Copy this file to .env and update with your values

# Medium API Settings
# Get your token from https://medium.com/me/settings → Integration tokens
MEDIUM_API_TOKEN=your_medium_api_token_here

# Server Configuration
DEBUG=false                          # Set to 'true' for development debugging
NODE_ENV=development                 # 'development' or 'production'
API_PORT=8080                        # Port for the FastAPI backend
FRONTEND_URL=http://localhost:5173   # URL where frontend is running

# Database Settings
DATABASE_URL=sqlite:///data/scribley.db  # SQLite connection string

# Security (for production deployments)
# CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
# ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com 