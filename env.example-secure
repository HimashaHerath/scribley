# Scribley Production Environment Configuration
# Copy this file to .env for secure production deployment

# Medium API Settings
# Get your token from https://medium.com/me/settings → Integration tokens
MEDIUM_API_TOKEN=your_medium_api_token_here

# Server Configuration
DEBUG=false
NODE_ENV=production
API_PORT=8080

# Security Settings
# IMPORTANT: Change these values for your production environment
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com
 
# Set request rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15m

# Database Settings
# For production, consider using a more robust database
# The connection string below is for SQLite but with a specific path
DATABASE_URL=sqlite:///data/scribley-prod.db

# Token Rotation
# Set to true to enforce regular token rotation
ENFORCE_TOKEN_ROTATION=true
TOKEN_MAX_AGE_DAYS=90

# Logging
LOG_LEVEL=warning
LOG_FILE=/var/log/scribley/app.log

# TLS/SSL Settings (if not using reverse proxy)
# ENABLE_HTTPS=true
# SSL_CERT_FILE=/path/to/cert.pem
# SSL_KEY_FILE=/path/to/key.pem 